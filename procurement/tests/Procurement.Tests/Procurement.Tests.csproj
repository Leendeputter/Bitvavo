<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>Procurement.Tests</RootNamespace>
    <AssemblyName>Procurement.Tests</AssemblyName>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Procurement.Core\Procurement.Core.csproj" />
    <ProjectReference Include="..\..\src\Procurement.Suppliers.DigiKey\Procurement.Suppliers.DigiKey.csproj" />
    <ProjectReference Include="..\..\src\Procurement.Suppliers.Farnell\Procurement.Suppliers.Farnell.csproj" />
    <ProjectReference Include="..\..\src\Procurement.Suppliers.Mouser\Procurement.Suppliers.Mouser.csproj" />
    <ProjectReference Include="..\..\src\Procurement.Suppliers.TME\Procurement.Suppliers.TME.csproj" />
    <ProjectReference Include="..\..\src\Procurement.Suppliers.Other\Procurement.Suppliers.Other.csproj" />
    <ProjectReference Include="..\..\src\Procurement.Erp\Procurement.Erp.csproj" />
  </ItemGroup>

  <!--
    MaxPurchaseOrderRepositoryTests references MAX50's Order_Master type directly (to assert on
    field mappings) — Procurement.Erp.csproj already carries this same reference, but the test
    project needs its own compile-time visibility too, not just the transitive ProjectReference.
    Only meaningful on a machine with MAX installed (confirmed always true here) — see
    Procurement.Erp.csproj's own comment for the "discovered one FileNotFoundException at a time"
    caveat, which applies here too.
  -->
  <ItemGroup>
    <Reference Include="MAXCore">
      <HintPath>F:\Software\MAX\MAX Update\MAXUpdateNet VB.NET Sample Code\bin\MAXCore.dll</HintPath>
    </Reference>
    <Reference Include="MaxOrderNET">
      <HintPath>F:\Software\MAX\MAX Update\MAXUpdateNet VB.NET Sample Code\bin\MaxOrderNET.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>

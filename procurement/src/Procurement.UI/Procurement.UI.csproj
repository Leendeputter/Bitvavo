<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Procurement.UI</RootNamespace>
    <AssemblyName>Procurement.UI</AssemblyName>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppConfig>App.config</AppConfig>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Data" />
    <Reference Include="System.Configuration" />
  </ItemGroup>

  <!--
    Transitive dependencies of MAXCore/MaxOrderNET/MaxTransNET (MAX50), discovered one
    FileNotFoundException at a time since that library's own dependency list isn't documented
    anywhere available here — versions match what UniPro2026.csproj/packages.config reference.
    MyLogManager.Create(...) returns an NLog.LogFactory; MaxSQL.GetConnection uses Dapper
    internally (DapperExtensions added proactively — UniPro2026 always pairs the two, so it's
    a likely next failure otherwise).
  -->
  <ItemGroup>
    <PackageReference Include="NLog" Version="4.7.15" />
    <PackageReference Include="Dapper" Version="1.40.0" />
    <PackageReference Include="DapperExtensions" Version="1.4.3" />
  </ItemGroup>

  <!--
    Same MAX50 (Exact MAX ERP .NET Update SDK) references as UniPro2026.csproj, needed for
    LoginForm's MaxSQL.GetPrimaryConnection/GetConnection calls (company list + admin
    connection). Copied verbatim from UniPro2026's working project — TODO: confirm these
    HintPaths are correct on this build machine; not independently verified here.
  -->
  <ItemGroup>
    <Reference Include="MAXCore">
      <HintPath>F:\Software\MAX\MAX Update\MAXUpdateNet VB.NET Sample Code\bin\MAXCore.dll</HintPath>
    </Reference>
    <Reference Include="MaxOrderNET">
      <HintPath>F:\Software\MAX\MAX Update\MAXUpdateNet VB.NET Sample Code\bin\MaxOrderNET.dll</HintPath>
    </Reference>
    <Reference Include="MaxTransNET">
      <HintPath>F:\Software\MAX\MAX Update\MAXUpdateNet VB.NET Sample Code\bin\MaxTransNET.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Procurement.Core\Procurement.Core.csproj" />
    <ProjectReference Include="..\Procurement.Data\Procurement.Data.csproj" />
    <ProjectReference Include="..\Procurement.Erp\Procurement.Erp.csproj" />
    <ProjectReference Include="..\Procurement.Engine\Procurement.Engine.csproj" />
    <ProjectReference Include="..\Procurement.Suppliers.DigiKey\Procurement.Suppliers.DigiKey.csproj" />
    <ProjectReference Include="..\Procurement.Suppliers.Farnell\Procurement.Suppliers.Farnell.csproj" />
    <ProjectReference Include="..\Procurement.Suppliers.Mouser\Procurement.Suppliers.Mouser.csproj" />
    <ProjectReference Include="..\Procurement.Suppliers.TME\Procurement.Suppliers.TME.csproj" />
    <ProjectReference Include="..\Procurement.Suppliers.Arrow\Procurement.Suppliers.Arrow.csproj" />
    <ProjectReference Include="..\Procurement.Suppliers.Rutronik\Procurement.Suppliers.Rutronik.csproj" />
    <ProjectReference Include="..\Procurement.Suppliers.Other\Procurement.Suppliers.Other.csproj" />
  </ItemGroup>

  <!-- Designer-built forms (16 nov 2026, converted one screen at a time to match UniPro): the
       Designer file is nested under its form, and SubType=Form makes Visual Studio open the
       form in the Designer by default. Add a pair here for every newly converted screen. -->
  <ItemGroup>
    <Compile Update="Forms\AppSecretsForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\AppSecretsForm.Designer.cs">
      <DependentUpon>AppSecretsForm.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\SupplierMappingForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\SupplierMappingForm.Designer.cs">
      <DependentUpon>SupplierMappingForm.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\ApprovalForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\ApprovalForm.Designer.cs">
      <DependentUpon>ApprovalForm.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\AuditLogForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\AuditLogForm.Designer.cs">
      <DependentUpon>AuditLogForm.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\OrderConfirmationExceptionsForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\OrderConfirmationExceptionsForm.Designer.cs">
      <DependentUpon>OrderConfirmationExceptionsForm.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\FarnellShipToAddressPickerForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\FarnellShipToAddressPickerForm.Designer.cs">
      <DependentUpon>FarnellShipToAddressPickerForm.cs</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>

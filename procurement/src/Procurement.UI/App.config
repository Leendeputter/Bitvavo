<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <!--
    No static connection string here anymore: LoginForm resolves it at runtime (Windows
    identity + MAX company selection -> ProcurementConnectionStringHelper builds the
    "Unitron"/"Unitron_test" connection string), then CompositionRoot passes it straight into
    `new ProcurementDbContext(connectionString)`. The <providers> registration below is still
    needed regardless — it's how EF6 knows which SqlProviderServices to use for a
    System.Data.SqlClient connection string, whatever that string's actual value is.
  -->
  <entityFramework>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>

  <!--
    DigiKey/Farnell credentials do NOT belong here (never did, in hindsight — these keys used to
    sit below as TODO placeholders and were never actually read by any code). They're stored
    encrypted in Procurement_Supplier instead (Procurement.Core.Security.SecretProtector) and
    edited via Instellingen -> Suppliers -> "Credentials bewerken" — see README, section
    "Supplier-credentials", for the full picture including how the encryption key itself is
    managed (PROCUREMENT_SECRET_KEY environment variable, not App.config either).
  -->
  <!--
    MaxSQL.GetPrimaryConnection (MAX50) reads MyLogManager.Instance() as its first statement and
    throws a NullReferenceException if MyLogManager was never initialized — LoginForm calls
    MyLogManager.Create(Logging.FileName, Logging.Path, Logging.Debug) before touching MaxSQL.
    Defaults below are a guess (mirrors UniPro2026's own hardcoded Login.cs values, adjusted to
    this app's name) — override here, no rebuild needed, if these are wrong for this machine.
  -->
  <appSettings>
    <add key="Logging.Path" value="C:\Unitron\Procurement\Log" />
    <add key="Logging.FileName" value="Procurement.log" />
    <add key="Logging.Debug" value="true" />
  </appSettings>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="EntityFramework" publicKeyToken="b77a5c561934e089" culture="neutral" />
        <!-- EntityFramework.dll's AssemblyVersion has stayed pinned at 6.0.0.0 across every 6.x NuGet release (6.1, 6.2, 6.3, 6.4.x) -->
        <bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="NLog" publicKeyToken="5120e14c03d0593c" culture="neutral" />
        <!-- Same pattern as EntityFramework above: NLog.dll's AssemblyVersion is pinned at 4.0.0.0 across the 4.x line (matches the "NLog, Version=4.0.0.0" reference MAXCore was built against, per UniPro2026.csproj). -->
        <bindingRedirect oldVersion="0.0.0.0-4.0.0.0" newVersion="4.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
